<% layout("/layouts/boilerplate.ejs") %>

<style>
  .result-page {
    background: radial-gradient(circle at top left, rgba(13, 110, 253, 0.08), transparent 30rem),
                radial-gradient(circle at bottom right, rgba(32, 201, 151, 0.06), transparent 30rem),
                #f8fafc;
    min-height: 100vh;
  }
  .glass-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }
  .score-circle {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 8px solid #f1f5f9;
    border-top-color: #0d6efd;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    background-color: #ffffff;
    box-shadow: 0 8px 24px rgba(13, 110, 253, 0.1);
  }
  .metric-card {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    padding: 1rem;
    text-align: center;
  }
  .weakness-badge {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .review-card {
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    transition: transform 0.2s ease;
  }
  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.02);
  }
  .option-box {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    background-color: #f8fafc;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .option-box.correct {
    border-color: #10b981;
    background-color: #ecfdf5;
    color: #065f46;
    font-weight: 600;
  }
  .option-box.wrong {
    border-color: #ef4444;
    background-color: #fef2f2;
    color: #991b1b;
    font-weight: 600;
  }
  .solution-panel {
    background-color: #f8fafc;
    border-left: 4px solid #64748b;
    border-radius: 0 12px 12px 0;
  }
</style>

<div class="result-page py-5">
  <div class="container" style="max-width: 850px;">
    <!-- Top Action Panel -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">Assessment Results</h3>
      <a href="/content/<%= attempt.quiz.chapterID._id %>" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-journal-bookmark me-1"></i>Back to Curriculum
      </a>
    </div>

    <!-- Score Summary Dashboard Card -->
    <div class="glass-card p-4 p-md-5 mb-4 text-center">
      <div class="row align-items-center g-4">
        <div class="col-md-5">
          <!-- Score Circle Gauge -->
          <% const accuracy = Math.round((attempt.score / attempt.totalQuestions) * 100); %>
          <div class="score-circle mb-3">
            <span class="fs-1 fw-bold text-dark"><%= accuracy %>%</span>
            <span class="text-secondary small fw-semibold">Accuracy</span>
          </div>
          <h4 class="fw-bold mb-1">Score: <%= attempt.score %> / <%= attempt.totalQuestions %></h4>
          <p class="text-muted small">Completed on <%= new Date(attempt.createdAt).toLocaleString() %></p>
        </div>

        <div class="col-md-7 border-start-md">
          <h5 class="fw-bold text-dark text-start mb-3">Performance Metrics</h5>
          
          <div class="row g-2 mb-3">
            <div class="col-6 col-sm-4">
              <div class="metric-card">
                <div class="text-success mb-1"><i class="bi bi-check-circle-fill fs-5"></i></div>
                <div class="text-secondary small fw-semibold">Correct</div>
                <div class="fs-4 fw-bold text-success"><%= attempt.score %></div>
              </div>
            </div>
            <div class="col-6 col-sm-4">
              <div class="metric-card">
                <div class="text-danger mb-1"><i class="bi bi-x-circle-fill fs-5"></i></div>
                <div class="text-secondary small fw-semibold">Incorrect</div>
                <div class="fs-4 fw-bold text-danger"><%= attempt.totalQuestions - attempt.score %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="metric-card">
                <div class="text-primary mb-1"><i class="bi bi-lightning-fill fs-5"></i></div>
                <div class="text-secondary small fw-semibold">Outcome</div>
                <div class="fs-5 fw-bold text-primary">
                  <%= accuracy >= 80 ? 'Mastery' : accuracy >= 50 ? 'Developing' : 'Review Needed' %>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick feedback message -->
          <div class="text-start bg-light p-3 rounded-3 small">
            <% if (accuracy >= 80) { %>
              <strong class="text-success"><i class="bi bi-trophy-fill me-1"></i> Excellent Job!</strong> You have demonstrated a high level of understanding of this chapter's concepts.
            <% } else if (accuracy >= 50) { %>
              <strong class="text-warning"><i class="bi bi-award-fill me-1"></i> Good Attempt!</strong> You are building a strong foundation, but please review the weakness areas identified below.
            <% } else { %>
              <strong class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Needs Focus!</strong> We recommend going over the study materials and lecture videos again, then retaking this quiz.
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Weakness Analysis Card -->
    <div class="glass-card p-4 mb-4">
      <h5 class="fw-bold mb-2 text-danger d-flex align-items-center gap-2">
        <i class="bi bi-shield-exclamation fs-4"></i> Weakness Analysis & Focus Areas
      </h5>
      <p class="text-muted small mb-3">Based on your incorrect answers, the system has identified the following topics and sub-topics you should focus on:</p>

      <div class="d-grid gap-3">
        <!-- Target Chapters -->
        <div>
          <span class="text-dark fw-bold small d-block mb-2">Chapters to Review:</span>
          <% if (attempt.weaknesses && attempt.weaknesses.chapters && attempt.weaknesses.chapters.length > 0) { %>
            <div class="d-flex flex-wrap gap-2">
              <% attempt.weaknesses.chapters.forEach(ch => { %>
                <span class="weakness-badge">
                  <i class="bi bi-journal-x"></i> <%= ch %>
                </span>
              <% }) %>
            </div>
          <% } else { %>
            <span class="text-success small fw-semibold"><i class="bi bi-check2-all me-1"></i> No chapters flagged. Excellent performance!</span>
          <% } %>
        </div>

        <!-- Target Tags -->
        <div>
          <span class="text-dark fw-bold small d-block mb-2">Key Concepts to Practice:</span>
          <% if (attempt.weaknesses && attempt.weaknesses.tags && attempt.weaknesses.tags.length > 0) { %>
            <div class="d-flex flex-wrap gap-2">
              <% attempt.weaknesses.tags.forEach(tag => { %>
                <span class="weakness-badge bg-danger-subtle text-danger border-danger-subtle">
                  <i class="bi bi-tag-fill text-danger"></i> <%= tag %>
                </span>
              <% }) %>
            </div>
          <% } else { %>
            <span class="text-success small fw-semibold"><i class="bi bi-check2-all me-1"></i> No core concepts flagged. Ready for next topic!</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Question-by-Question Review -->
    <h4 class="fw-bold text-dark mb-3 mt-5">Question Review</h4>
    <div class="d-grid gap-4">
      <% attempt.answers.forEach((ans, index) => { %>
        <% const qsn = ans.question; %>
        <div class="card review-card shadow-sm p-4">
          <!-- Question Header Status -->
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-secondary-subtle text-secondary py-1.5 px-3 rounded-pill fw-bold">
              Question <%= index + 1 %>
            </span>
            <% if (ans.isCorrect) { %>
              <span class="badge bg-success-subtle text-success py-1.5 px-3 rounded-pill fw-bold border border-success-subtle">
                <i class="bi bi-check-circle-fill me-1"></i> Correct
              </span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger py-1.5 px-3 rounded-pill fw-bold border border-danger-subtle">
                <i class="bi bi-x-circle-fill me-1"></i> Incorrect
              </span>
            <% } %>
          </div>

          <!-- Question Content -->
          <h5 class="fw-bold mb-3 text-dark"><%= qsn.question_text %></h5>
          <% if (qsn.question_img && qsn.question_img.url) { %>
            <div class="my-3 text-center bg-light p-3 rounded-3 border">
              <img src="<%= qsn.question_img.url %>" alt="Question diagram" class="img-fluid rounded" style="max-height: 220px;">
            </div>
          <% } %>

          <!-- Options Grid -->
          <div class="row row-cols-1 row-cols-md-2 g-3 mt-1 mb-4">
            <% qsn.options.forEach((opt, oIdx) => { %>
              <% 
                const optionLabel = String.fromCharCode(65 + oIdx);
                const isCorrect = qsn.correctOption && qsn.correctOption.toString() === opt._id.toString();
                const isSelected = ans.selectedOption && ans.selectedOption.toString() === opt._id.toString();
                
                let boxClass = "";
                let badgeText = "";
                let badgeClass = "";
                
                if (isCorrect) {
                  boxClass = "correct";
                  badgeText = "Correct Answer";
                  badgeClass = "bg-success text-white";
                } else if (isSelected && !isCorrect) {
                  boxClass = "wrong";
                  badgeText = "Your Answer";
                  badgeClass = "bg-danger text-white";
                }
              %>
              <div class="col">
                <div class="option-box <%= boxClass %> h-100 justify-content-between">
                  <div class="d-flex align-items-center gap-3">
                    <span class="badge <%= isCorrect ? 'bg-success text-white' : isSelected ? 'bg-danger text-white' : 'bg-secondary text-white' %> rounded-circle px-2 py-1.5" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                      <%= optionLabel %>
                    </span>
                    <div>
                      <% if (opt.text) { %>
                        <span><%= opt.text %></span>
                      <% } %>
                      <% if (opt.img && opt.img.url) { %>
                        <div class="mt-1">
                          <img src="<%= opt.img.url %>" alt="Option image" class="img-fluid rounded border" style="max-height: 80px;">
                        </div>
                      <% } %>
                    </div>
                  </div>
                  <% if (badgeText) { %>
                    <span class="badge <%= badgeClass %> px-2 py-1 small rounded-pill"><%= badgeText %></span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Explanation/Solution Section -->
          <% if ((qsn.solution && qsn.solution.text) || (qsn.solution && qsn.solution.img && qsn.solution.img.url)) { %>
            <div class="solution-panel p-3">
              <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-info-circle-fill"></i> Solution & Explanation</h6>
              <% if (qsn.solution.text) { %>
                <p class="mb-2 text-dark small" style="white-space: pre-line;"><%= qsn.solution.text %></p>
              <% } %>
              <% if (qsn.solution.img && qsn.solution.img.url) { %>
                <div class="mt-2 text-center bg-white p-2 rounded border">
                  <img src="<%= qsn.solution.img.url %>" alt="Solution diagram" class="img-fluid rounded" style="max-height: 180px;">
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
