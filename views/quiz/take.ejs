<% layout("/layouts/boilerplate.ejs") %>

<style>
  .take-quiz-page {
    background: radial-gradient(circle at top left, rgba(13, 110, 253, 0.08), transparent 30rem),
                radial-gradient(circle at bottom right, rgba(32, 201, 151, 0.06), transparent 30rem),
                #f8fafc;
    min-height: 100vh;
  }
  .quiz-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
  }
  .progress {
    height: 8px;
    border-radius: 999px;
    background-color: #e2e8f0;
  }
  .progress-bar {
    background-color: #0d6efd;
    border-radius: 999px;
    transition: width 0.3s ease;
  }
  .question-container {
    display: none;
  }
  .question-container.active {
    display: block;
    animation: fadeIn 0.4s ease-in-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .option-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: 500;
    color: #475569;
    background-color: #ffffff;
  }
  .option-card:hover {
    border-color: #cbd5e1;
    background-color: #f8fafc;
  }
  .option-radio {
    display: none;
  }
  .option-radio:checked + .option-card {
    border-color: #0d6efd;
    background-color: #f1f5f9;
    color: #0d6efd;
  }
  .option-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .option-radio:checked + .option-card .option-badge {
    background-color: #0d6efd;
    color: #ffffff;
  }
</style>

<div class="take-quiz-page py-5">
  <div class="container" style="max-width: 750px;">
    <!-- Top Quiz Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1"><%= quiz.title %></h2>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
          <i class="bi bi-clock me-1"></i> Interactive Practice Session
        </span>
      </div>
      <button class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#quitModal">
        Quit Session
      </button>
    </div>

    <!-- Main Quiz Form -->
    <form action="/quiz/<%= quiz._id %>/submit" method="POST" id="quizForm">
      <div class="quiz-card p-4 p-md-5">
        <!-- Progress Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-secondary small fw-semibold">
            Question <span id="currentQuestionNum">1</span> of <%= quiz.questions.length %>
          </span>
          <span id="completionPercent" class="text-secondary small fw-semibold">0% Completed</span>
        </div>
        <div class="progress mb-4">
          <div class="progress-bar" role="progressbar" style="width: <%= 100 / quiz.questions.length %>%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>

        <!-- Questions Loop -->
        <% quiz.questions.forEach((qsn, idx) => { %>
          <div class="question-container <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
            <!-- Question Box -->
            <div class="mb-4">
              <h4 class="fw-bold text-dark mb-3"><%= qsn.question_text %></h4>
              <% if (qsn.question_img && qsn.question_img.url) { %>
                <div class="my-3 text-center bg-light p-3 rounded-4 border">
                  <img src="<%= qsn.question_img.url %>" alt="Question Diagram" class="img-fluid rounded" style="max-height: 250px;">
                </div>
              <% } %>
            </div>

            <!-- Options Grid -->
            <div class="row row-cols-1 g-3">
              <% qsn.options.forEach((opt, oIdx) => { %>
                <% const optionLabel = String.fromCharCode(65 + oIdx); %>
                <div class="col">
                  <input type="radio" name="answers[<%= qsn._id %>]" value="<%= opt._id %>" id="opt_<%= qsn._id %>_<%= oIdx %>" class="option-radio">
                  <label for="opt_<%= qsn._id %>_<%= oIdx %>" class="option-card w-100">
                    <span class="option-badge"><%= optionLabel %></span>
                    <div class="flex-grow-1">
                      <% if (opt.text) { %>
                        <span><%= opt.text %></span>
                      <% } %>
                      <% if (opt.img && opt.img.url) { %>
                        <div class="mt-2">
                          <img src="<%= opt.img.url %>" alt="Option Image" class="img-fluid rounded border" style="max-height: 100px;">
                        </div>
                      <% } %>
                    </div>
                  </label>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>

        <!-- Navigation Row -->
        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="prevBtn" disabled>
            <i class="bi bi-chevron-left me-1"></i>Previous
          </button>
          <button type="button" class="btn btn-primary rounded-pill px-4" id="nextBtn">
            Next<i class="bi bi-chevron-right ms-1"></i>
          </button>
          <button type="submit" class="btn btn-success rounded-pill px-4 d-none" id="submitBtn">
            Submit Assessment<i class="bi bi-check2-circle ms-1"></i>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Quit assessment confirmation modal -->
<div class="modal fade" id="quitModal" tabindex="-1" aria-labelledby="quitModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
      <div class="modal-body p-4 text-center">
        <div class="text-danger mb-3"><i class="bi bi-exclamation-octagon fs-1"></i></div>
        <h4 class="fw-bold mb-2">Quit Assessment?</h4>
        <p class="text-muted mb-4">Your current progress will not be saved. Are you sure you want to quit?</p>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <a href="/content/<%= quiz.chapterID %>" class="btn btn-danger rounded-pill px-4">Quit Anyway</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const questions = document.querySelectorAll(".question-container");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const submitBtn = document.getElementById("submitBtn");
  const currentNumSpan = document.getElementById("currentQuestionNum");
  const completionPercentSpan = document.getElementById("completionPercent");
  const progressBar = document.querySelector(".progress-bar");

  let currentIndex = 0;
  const totalQuestions = questions.length;

  function updateQuizNavigation() {
    // Show current question container
    questions.forEach((q, idx) => {
      q.classList.toggle("active", idx === currentIndex);
    });

    // Update index labels
    currentNumSpan.textContent = currentIndex + 1;
    const progressPercent = Math.round(((currentIndex + 1) / totalQuestions) * 100);
    progressBar.style.width = `${progressPercent}%`;
    completionPercentSpan.textContent = `${Math.round((currentIndex / totalQuestions) * 100)}% Completed`;

    // Toggle button visibilities
    prevBtn.disabled = currentIndex === 0;

    if (currentIndex === totalQuestions - 1) {
      nextBtn.classList.add("d-none");
      submitBtn.classList.remove("d-none");
    } else {
      nextBtn.classList.remove("d-none");
      submitBtn.classList.add("d-none");
    }
  }

  nextBtn.addEventListener("click", () => {
    if (currentIndex < totalQuestions - 1) {
      currentIndex++;
      updateQuizNavigation();
    }
  });

  prevBtn.addEventListener("click", () => {
    if (currentIndex > 0) {
      currentIndex--;
      updateQuizNavigation();
    }
  });

  // Highlight selected options automatically on clicking next
  questions.forEach(container => {
    const radios = container.querySelectorAll(".option-radio");
    radios.forEach(radio => {
      radio.addEventListener("change", () => {
        // Auto-progress optional delay for smoother UX
        setTimeout(() => {
          if (currentIndex < totalQuestions - 1) {
            nextBtn.click();
          }
        }, 300);
      });
    });
  });
</script>
