<% layout("/layouts/boilerplate.ejs") %>

<main class="content-page py-5">
  <div class="container content-wrap">
    
    <!-- Welcome Header Banner -->
    <header class="content-hero p-4 p-md-5 mb-5 text-center text-md-start">
      <div class="row align-items-center g-4">
        <div class="col-md-8">
          <span class="content-kicker mb-3 d-inline-flex">❇️ Start Learning</span>
          <h1 class="content-title fw-bold mb-3">Welcome back, <%= user ? user.username : 'Learner' %>!</h1>
          <p class="text-secondary fs-5 mb-0">Explore your mapped exam tracks, review curriculum resources, and stay up-to-date with official notifications.</p>
        </div>
        <div class="col-md-4 text-center text-md-end">
          <div class="d-inline-block text-start bg-white p-3 rounded-4 shadow-sm border border-light" style="max-width: 260px;">
            <div class="d-flex align-items-center gap-3">
              <span class="avatar-sm fs-5" style="width:48px; height:48px; display:grid; place-items:center; background:linear-gradient(135deg, #0d6efd, #3b82f6); color:white; border-radius:50%; font-weight:bold;">
                <%= user ? user.username.substring(0, 2).toUpperCase() : 'LN' %>
              </span>
              <div>
                <div class="fw-bold text-truncate" style="max-width: 150px;"><%= user ? user.username : 'Guest Student' %></div>
                <div class="text-secondary small text-truncate" style="max-width: 150px;"><%= user ? user.email : 'guest@saarthi.edu' %></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Learning Metrics Overview -->
    <section class="row g-4 mb-5">
      <div class="col-12 col-md-4">
        <div class="card content-list-card h-100 p-4 shadow-sm">
          <div class="d-flex align-items-center gap-3">
            <div class="resource-icon bg-primary-subtle text-primary">
              <i class="bi bi-play-circle fs-3"></i>
            </div>
            <div>
              <h2 class="h6 text-secondary fw-semibold mb-1">Video Lectures</h2>
              <div class="h3 fw-bold mb-0"><%= stats.lectures %>+ Available</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card content-list-card h-100 p-4 shadow-sm">
          <div class="d-flex align-items-center gap-3">
            <div class="resource-icon bg-success-subtle text-success">
              <i class="bi bi-file-earmark-text fs-3"></i>
            </div>
            <div>
              <h2 class="h6 text-secondary fw-semibold mb-1">Study Notes</h2>
              <div class="h3 fw-bold mb-0"><%= stats.notes %>+ PDFs Ready</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card content-list-card h-100 p-4 shadow-sm">
          <div class="d-flex align-items-center gap-3">
            <div class="resource-icon bg-warning-subtle text-warning">
              <i class="bi bi-file-earmark-spreadsheet fs-3"></i>
            </div>
            <div>
              <h2 class="h6 text-secondary fw-semibold mb-1">Practice Sheets</h2>
              <div class="h3 fw-bold mb-0"><%= stats.sheets %>+ Test Sets</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Grid Dashboard layout -->
    <div class="row g-4">
      
      <!-- Exam Tracks Section -->
      <section class="col-12 col-lg-8" aria-labelledby="tracks-heading">
        <div class="card border-0 bg-transparent mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0" id="tracks-heading"><i class="bi bi-mortarboard me-2 text-primary"></i>Your Exam Tracks</h2>
            <span class="badge bg-light text-secondary border">Active Curriculum</span>
          </div>
        </div>

        <div class="row g-4">
          <% if (exams.length === 0) { %>
            <div class="col-12 text-center py-5 border border-dashed rounded-4 text-muted bg-white">
              <i class="bi bi-journal-x fs-2 d-block mb-3 text-secondary"></i>
              No exam tracks are currently live on Saarthi.
            </div>
          <% } else { %>
            <% exams.forEach((exam) => { %>
              <div class="col-12 col-sm-6">
                <article class="card content-card shadow-sm h-100 p-4 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-4">
                      <span class="fs-1"><%= exam.icon || '📚' %></span>
                      <span class="badge bg-light-subtle text-primary border border-primary-subtle"><%= exam.courseType %></span>
                    </div>
                    <h3 class="h5 fw-bold mb-2"><%= exam.examName %></h3>
                    <p class="text-secondary small mb-4">Access comprehensive subjects, video lectures, and practice sets mapped for <%= exam.examName %> preparation.</p>
                  </div>
                  <div class="d-grid mt-2">
                    <a href="/subject/<%= exam._id %>" class="btn btn-outline-primary rounded-pill w-100">
                      Explore Course <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>
                </article>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>

      <!-- Important Updates Section -->
      <section class="col-12 col-lg-4" aria-labelledby="updates-heading">
        <div class="card border-0 bg-transparent mb-3">
          <h2 class="h4 fw-bold mb-0" id="updates-heading"><i class="bi bi-bell me-2 text-warning"></i>Important Notices</h2>
        </div>
        
        <div class="card content-list-card p-4 shadow-sm bg-white">
          <div class="d-grid gap-4">
            <% if (importantUpdates.length === 0) { %>
              <div class="text-muted text-center py-4">
                <i class="bi bi-check2-circle fs-3 d-block mb-2 text-success"></i>
                No important notices posted.
              </div>
            <% } else { %>
              <% importantUpdates.forEach((notice) => { %>
                <div class="d-flex align-items-start gap-3">
                  <div class="activity-icon bg-warning-subtle text-warning" style="width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0;">
                    <i class="bi bi-exclamation-triangle"></i>
                  </div>
                  <div>
                    <h3 class="h6 fw-bold mb-1"><%= notice.title %></h3>
                    <p class="text-secondary small mb-2 line-clamp-2"><%= notice.content %></p>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="badge text-bg-light border" style="font-size: 0.7rem;"><%= notice.category %></span>
                      <span class="text-muted" style="font-size: 0.7rem;"><%= new Date(notice.date).toLocaleDateString() %></span>
                    </div>
                  </div>
                </div>
              <% }) %>
              <div class="text-center border-top pt-3">
                <a href="/updates" class="btn btn-sm btn-soft rounded-pill w-100">View All Announcements</a>
              </div>
            <% } %>
          </div>
        </div>
      </section>

    </div>
  </div>
</main>
