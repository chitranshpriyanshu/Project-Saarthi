<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container py-5">
  <% if (success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>
  <% if (error.length)   { %><div class="alert alert-danger"><%= error[0] %></div><% } %>
  <h1 class="fw-bold mb-1">All Exams</h1>
  <p class="text-muted mb-5">Browse preparation resources organised by exam category.</p>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    <% exams.forEach(exam => { %>
    <div class="col">
      <div class="card h-100 border bg-<%= exam.colorClass %>-subtle border-<%= exam.colorClass %>">
        <div class="card-body d-flex flex-column gap-3">
          <div class="d-flex justify-content-between align-items-start">
            <span class="fs-2"><%= exam.icon %></span>
            <span class="badge bg-secondary-subtle text-secondary"><%= exam.standard %></span>
          </div>
          <div>
            <h5 class="fw-semibold"><%= exam.name %></h5>
            <p class="text-muted small"><%= exam.description %></p>
          </div>
          <div>
            <p class="small fw-semibold text-muted mb-1">Subjects covered</p>
            <div class="d-flex flex-wrap gap-1">
              <% exam.subjects.forEach(s => { %>
              <span class="badge bg-white text-dark border"><%= s %></span>
              <% }) %>
            </div>
          </div>
          <div class="mt-auto d-flex justify-content-between align-items-center border-top pt-3">
            <span class="text-muted small"><i class="bi bi-book me-1"></i><%= exam.totalResources %> resources</span>
            <a href="/library?exam=<%= exam.id %>" class="btn btn-sm btn-primary">Browse <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>
