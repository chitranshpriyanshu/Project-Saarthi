<% layout("/layouts/boilerplate.ejs") %>

<style>
    .question-card {
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e2e8f0;
    }
    .question-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }
    .option-box {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        background-color: #f8fafc;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .option-box.correct {
        border-color: #10b981;
        background-color: #ecfdf5;
        color: #065f46;
        font-weight: 600;
    }
    .badge-easy {
        background-color: #d1fae5;
        color: #065f46;
    }
    .badge-medium {
        background-color: #fef3c7;
        color: #92400e;
    }
    .badge-hard {
        background-color: #fee2e2;
        color: #991b1b;
    }
    .tag-badge {
        background-color: #f1f5f9;
        color: #475569;
        font-size: 0.8rem;
    }
</style>

<div class="container mt-4 mb-5">
    <!-- Header Area -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Question Bank</h1>
            <p class="text-secondary mb-0">Browse and manage platform-wide practice questions, options, and solutions.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="card shadow-sm border-0 mb-4 bg-white" style="border-radius: 16px;">
        <div class="card-body p-3">
            <div class="row g-2">
                <!-- Search bar -->
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input 
                            type="text" 
                            id="searchBar" 
                            class="form-control border-start-0" 
                            placeholder="Search questions by text...">
                    </div>
                </div>
                
                <!-- Filter by Exam -->
                <div class="col-6 col-md-3">
                    <select id="examFilter" class="form-select">
                        <option value="">All Exams</option>
                        <% exams.forEach(exam => { %>
                            <option value="<%= exam._id %>"><%= exam.examName %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Filter by Subject -->
                <div class="col-6 col-md-3">
                    <select id="subjectFilter" class="form-select">
                        <option value="">All Subjects</option>
                        <!-- Dynamic based on selected exam or gathered from unique subjects -->
                        <% 
                            let uniqueSubjects = [...new Set(questions.map(q => q.subject))].filter(Boolean);
                            uniqueSubjects.forEach(sub => {
                        %>
                            <option value="<%= sub %>"><%= sub %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Filter by Difficulty -->
                <div class="col-12 col-md-2">
                    <select id="levelFilter" class="form-select">
                        <option value="">All Difficulty</option>
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions Container -->
    <div id="questionsList" class="row row-cols-1 g-4">
        <% if (questions.length === 0) { %>
            <div class="col-12 text-center py-5">
                <div class="text-secondary mb-3"><i class="bi bi-folder-x fs-1"></i></div>
                <h4 class="fw-semibold">No questions found</h4>
                <p class="text-muted">Create a question from the curriculum structure in the Admin Dashboard.</p>
                <a href="/admin#hierarchy" class="btn btn-primary rounded-pill mt-2">Go to Curriculum</a>
            </div>
        <% } else { %>
            <% questions.forEach((qsn, idx) => { %>
                <div 
                    class="col question-item" 
                    data-course-id="<%= qsn.course ? qsn.course._id : '' %>"
                    data-subject="<%= qsn.subject %>"
                    data-level="<%= qsn.level %>"
                    data-text="<%= qsn.question_text.toLowerCase() %>"
                >
                    <div class="card question-card shadow-sm bg-white h-100">
                        <!-- Card Header -->
                        <div class="card-header bg-white border-0 pt-3 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2.5 rounded-pill small">
                                    <%= qsn.course ? qsn.course.examName : 'Unknown Exam' %>
                                </span>
                                <span class="badge bg-light text-dark py-1 px-2 rounded-pill small border">
                                    <%= qsn.subject %>
                                </span>
                                <span class="badge bg-light text-dark py-1 px-2 rounded-pill small border">
                                    <%= qsn.chapter %>
                                </span>
                                <% 
                                    let levelClass = 'badge-medium';
                                    if (qsn.level === 'Easy') levelClass = 'badge-easy';
                                    if (qsn.level === 'Hard') levelClass = 'badge-hard';
                                %>
                                <span class="badge <%= levelClass %> py-1 px-2.5 rounded-pill small">
                                    <%= qsn.level %>
                                </span>
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-clock me-1"></i><%= new Date(qsn.createdAt).toLocaleDateString() %>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body px-3 py-2">
                            <!-- Question Content -->
                            <div class="mb-3">
                                <p class="fw-semibold fs-5 mb-2"><%= qsn.question_text %></p>
                            </div>

                            <!-- Question Image and Options Accordion -->
                            <div class="accordion accordion-flush mb-2" id="qsnAccordion<%= idx %>">
                                <div class="accordion-item border-0">
                                    <h2 class="accordion-header">
                                        <button 
                                            class="accordion-button collapsed py-2 px-0 bg-transparent text-primary fw-semibold" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#qsnCollapse<%= idx %>" 
                                            aria-expanded="false" 
                                            aria-controls="qsnCollapse<%= idx %>"
                                        >
                                            <i class="bi bi-card-image me-1"></i> View Question Image & Options
                                        </button>
                                    </h2>
                                    <div id="qsnCollapse<%= idx %>" class="accordion-collapse collapse" data-bs-parent="#qsnAccordion<%= idx %>">
                                        <div class="accordion-body px-0 py-2 border-top">
                                            <% if (qsn.question_img && qsn.question_img.url) { %>
                                                <div class="mt-2 mb-3 text-center">
                                                    <img src="<%= qsn.question_img.url %>" alt="Question diagram" class="img-fluid rounded border" style="max-height: 250px;">
                                                </div>
                                            <% } %>

                                            <!-- Options Grid -->
                                            <div class="row row-cols-1 row-cols-md-2 g-3 mt-1 mb-2">
                                                <% qsn.options.forEach((opt, oIdx) => { %>
                                                    <% 
                                                        let isCorrect = qsn.correctOption && qsn.correctOption.toString() === opt._id.toString();
                                                        let label = String.fromCharCode(65 + oIdx); // A, B, C, D
                                                    %>
                                                    <div class="col">
                                                        <div class="option-box <%= isCorrect ? 'correct' : '' %>">
                                                            <span class="badge <%= isCorrect ? 'bg-success text-white' : 'bg-secondary text-white' %> rounded-circle px-2 py-1.5" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                                                <%= label %>
                                                            </span>
                                                            <div class="flex-grow-1">
                                                                <div><%= opt.text %></div>
                                                                <% if (opt.img && opt.img.url) { %>
                                                                    <div class="mt-1">
                                                                        <img src="<%= opt.img.url %>" alt="Option <%= label %> image" class="img-fluid rounded border" style="max-height: 100px;">
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                            <% if (isCorrect) { %>
                                                                <i class="bi bi-check-circle-fill fs-5 text-success ms-auto"></i>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Solution Accordion -->
                            <div class="accordion accordion-flush mb-3" id="solAccordion<%= idx %>">
                                <div class="accordion-item border-0">
                                    <h2 class="accordion-header">
                                        <button 
                                            class="accordion-button collapsed py-2 px-0 bg-transparent text-primary fw-semibold" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#solCollapse<%= idx %>" 
                                            aria-expanded="false" 
                                            aria-controls="solCollapse<%= idx %>"
                                        >
                                            <i class="bi bi-lightbulb-fill me-1 text-warning"></i> View Explanation & Tags
                                        </button>
                                    </h2>
                                    <div id="solCollapse<%= idx %>" class="accordion-collapse collapse" data-bs-parent="#solAccordion<%= idx %>">
                                        <div class="accordion-body px-0 py-2 border-top">
                                            <% if (qsn.solution && (qsn.solution.text || (qsn.solution.img && qsn.solution.img.url))) { %>
                                                <p class="mb-2"><%= qsn.solution.text || 'No text explanation provided.' %></p>
                                                <% if (qsn.solution.img && qsn.solution.img.url) { %>
                                                    <div class="mt-2 mb-2">
                                                        <img src="<%= qsn.solution.img.url %>" alt="Solution diagram" class="img-fluid rounded border" style="max-height: 200px;">
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                <p class="text-muted small mb-2">No detailed explanation provided.</p>
                                            <% } %>
                                            
                                            <% if (qsn.tags && qsn.tags.length > 0) { %>
                                                <div class="mt-3">
                                                    <span class="small text-secondary fw-semibold me-2">Tags:</span>
                                                    <% qsn.tags.forEach(tag => { %>
                                                        <span class="badge tag-badge rounded-pill me-1"><%= tag %></span>
                                                    <% }) %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-light border-0 py-3 px-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="small text-secondary">
                                Added by: <strong class="text-dark"><%= qsn.createdBy ? qsn.createdBy.username : 'Admin' %></strong>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/admin/question/edit/<%= qsn._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form action="/admin/question/delete/<%= qsn._id %>" method="POST" class="d-inline m-0" onsubmit="return confirm('Are you sure you want to delete this question?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const searchBar = document.getElementById("searchBar");
        const examFilter = document.getElementById("examFilter");
        const subjectFilter = document.getElementById("subjectFilter");
        const levelFilter = document.getElementById("levelFilter");
        const questionItems = document.querySelectorAll(".question-item");

        function filterQuestions() {
            const searchText = searchBar.value.toLowerCase().trim();
            const selectedExam = examFilter.value;
            const selectedSubject = subjectFilter.value;
            const selectedLevel = levelFilter.value;

            questionItems.forEach(item => {
                const itemText = item.getAttribute("data-text");
                const itemCourse = item.getAttribute("data-course-id");
                const itemSubject = item.getAttribute("data-subject");
                const itemLevel = item.getAttribute("data-level");

                const matchesSearch = !searchText || itemText.includes(searchText);
                const matchesExam = !selectedExam || itemCourse === selectedExam;
                const matchesSubject = !selectedSubject || itemSubject === selectedSubject;
                const matchesLevel = !selectedLevel || itemLevel === selectedLevel;

                if (matchesSearch && matchesExam && matchesSubject && matchesLevel) {
                    item.style.setProperty("display", "", "important");
                } else {
                    item.style.setProperty("display", "none", "important");
                }
            });
        }

        searchBar.addEventListener("input", filterQuestions);
        examFilter.addEventListener("change", filterQuestions);
        subjectFilter.addEventListener("change", filterQuestions);
        levelFilter.addEventListener("change", filterQuestions);
    });
</script>
