<% layout("/layouts/boilerplate.ejs") %>

<main class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold">Add Quote of the Day</h2>
      <p class="text-muted mb-0">Publish a new daily motivational quote for students.</p>
    </div>
    <a href="/admin" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Admin
    </a>
  </div>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <form action="/admin/addQuote" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">Quote Content</label>
          <textarea name="content" class="form-control" rows="4" placeholder="Type the quote content here..." required></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Author (Optional)</label>
          <input type="text" name="author" class="form-control" placeholder="Anonymous, Albert Einstein, Curator...">
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Save Quote
          </button>
          <button type="reset" class="btn btn-outline-secondary">Reset</button>
        </div>
      </form>
    </div>
  </div>
</main>
