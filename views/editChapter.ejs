<%layout("/layouts/boilerplate.ejs")%>

<main class="bg-light min-vh-100 py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-xl-10">

        <div class="card border-0 shadow-lg">
          <div class="card-header bg-primary text-white p-4">
            <h2 class="mb-1">📚 Edit Chapter</h2>
            <p class="mb-0">
              Subject:
              <strong><%= subject.subjectName %></strong>
            </p>
          </div>

          <div class="card-body p-4">

            <form action="/admin/chapter/<%= chapter._id %>/edit" method="POST">

              

              <div id="chapterContainer">

                <div class="chapter-card border rounded p-4 mb-4">

                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><%=chapter.chapterName%></h5>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Chapter Name</label>
                    <input
                      type="text"
                      class="form-control"
                      name="chapter[chapterName]"
                      value="<%=chapter.chapterName%>"
                      required
                    >
                  </div>

                  <div>
                    <label class="form-label">Description</label>
                    <textarea
                      class="form-control"
                      rows="4"
                      name="chapter[description]"
                      required
                    ><%=chapter.description%></textarea>
                  </div>

                </div>

              </div>

              <div class="d-flex gap-3 flex-wrap">

              

                <button
                  type="submit"
                  class="btn btn-primary"
                >
                  🚀 Save Chapter
                </button>

              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </div>
</main>

