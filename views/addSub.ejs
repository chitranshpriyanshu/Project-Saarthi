<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-5">

  <h2 class="mb-4">
    Setup Subjects for <%= exam.examName %>
  </h2>

  <form action="/admin/exam/<%= exam._id %>/addSubject" method="POST">

    <% exam.subjects.forEach((subject,index)=>{ %>

      <div class="card mb-4 shadow-sm">

        <div class="card-header fw-bold">
          <%= subject %>
        </div>

        <div class="card-body">

          <div class="mb-3">
            <label>Subject Icon</label>
            <input
              type="text"
              class="form-control"
              name="subjects[<%= index %>][icon]"
              placeholder="📘"
            >
          </div>

          <div class="mb-3">
            <label>Description</label>
            <textarea required
              class="form-control"
              rows="3"
              name="subjects[<%= index %>][description]"
            ></textarea>
          </div>

          <div class="mb-3">
            <label>Total Chapters</label>
            <input required
              type="number"
              min="0"
              class="form-control"
              name="subjects[<%= index %>][chapterCount]"
            >
          </div>

          <input
            type="hidden"
            name="subjects[<%= index %>][name]"
            value="<%= subject %>"
          >

        </div>

      </div>

    <% }) %>

    <button class="btn btn-success">
      Save Subject Details
    </button>

  </form>

</div>