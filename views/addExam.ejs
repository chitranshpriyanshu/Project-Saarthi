<div class="mb-4">
  <label class="form-label fw-semibold">
    Select Course Type:
  </label>

  <div class="form-check">
    <input class="form-check-input" type="radio" name="courseType" value="Crash Course">
    <label class="form-check-label">Crash Course</label>
  </div>

  <div class="form-check">
    <input class="form-check-input" type="radio" name="courseType" value="Complete Course">
    <label class="form-check-label">Complete Course</label>
  </div>

  <div class="form-check">
    <input class="form-check-input" type="radio" name="courseType" value="Practice Materials">
    <label class="form-check-label">Practice Materials</label>
  </div>

  <div class="form-check">
    <input
      class="form-check-input"
      type="radio"
      name="courseType"
      id="otherRadio"
      value="Other" required
    >
    <label class="form-check-label" for="otherRadio">
      Other
    </label>
  </div>

  <div id="otherInputWrapper" class="mt-2 d-none">
    <input
      type="text"
      class="form-control"
      name="otherCourseType"
      placeholder="Enter custom course type"
    >
  </div>
</div>
        <!-- Icon -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Icon
          </label>

          <input
            type="text"
            class="form-control"
            name="icon"
           
          >

          <div class="form-text">
            Example:📚,🏗️
          </div>
        </div>

        <!-- Buttons -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i>
            Save Exam
          </button>

          <button type="reset" class="btn btn-outline-secondary">
            Reset
          </button>
        </div>

      </form>

    </div>
  </div>

</main>

<script>
  const radios = document.querySelectorAll('input[name="courseType"]');
  const otherInputWrapper = document.getElementById('otherInputWrapper');

  radios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.value === 'Other' && radio.checked) {
        otherInputWrapper.classList.remove('d-none');
      } else {
        otherInputWrapper.classList.add('d-none');
      }
    });
  });
  const subjectFields = document.getElementById("subjectFields");
  const addSubjectBtn = document.getElementById("addSubjectBtn");

  addSubjectBtn.addEventListener("click", () => {

    const div = document.createElement("div");

    div.className = "input-group mb-2 subject-row";

    div.innerHTML = `
      <input
        type="text"
        name="subjects"
        class="form-control"
        placeholder="Subject Name"
      >

      <button
        type="button"
        class="btn btn-outline-danger remove-subject"
      >
        <i class="bi bi-trash"></i>
      </button>
    `;

    subjectFields.appendChild(div);
  });

  subjectFields.addEventListener("click", (e) => {

    const btn = e.target.closest(".remove-subject");

    if (!btn) return;

    const rows = document.querySelectorAll(".subject-row");

    if (rows.length > 1) {
      btn.closest(".subject-row").remove();
    } else {
      rows[0].querySelector("input").value = "";
    }
  });
</script>