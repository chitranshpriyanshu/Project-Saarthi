<% layout("/layouts/boilerplate.ejs") %>


<style>
 
</style>

<main class="content-page py-4 py-md-5">


  <div class="container content-wrap">
    <% if (typeof success !== "undefined" && success.length) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== "undefined" && error.length) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>


    <ul class="nav nav-tabs content-tabs mb-4" id="contentTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="lectures-tab" data-bs-toggle="tab" data-bs-target="#lectures" type="button" role="tab" aria-controls="lectures" aria-selected="true">
          Lectures
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button" role="tab" aria-controls="notes" aria-selected="false">
          Notes
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="practice-tab" data-bs-toggle="tab" data-bs-target="#practice" type="button" role="tab" aria-controls="practice" aria-selected="false">
          Practice Sheet
        </button>
      </li>
        <% if(user && user.admin) { %>
    <li class="ms-auto">
      <a href="/admin/content/<%= chapterData._id%>/addContent"
         class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i>
        Add Content
      </a>
    </li>
  <% } %>
    </ul>

    <div class="tab-content" id="contentTabsData">
      <section class="tab-pane fade show active" id="lectures" role="tabpanel" aria-labelledby="lectures-tab" tabindex="0">
        <div class="d-grid gap-4">
          <% lectureList.forEach((lecture, index) => { %>
            <div class="card content-card shadow-sm">
              <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                  <div>
                    <h2 class="h5 mb-1"><%= lecture.title %></h2>
                    <div class="text-muted small">
                      <i class="bi bi-person-video3 me-1"></i><%= lecture.faculty %>
                      <span class="mx-2">|</span>
                      <i class="bi bi-clock me-1"></i><%= lecture.duration %>
                    </div>
                  </div>
                <div class="d-flex gap-2">
  
  <% if(user && user.admin) { %>
    <a href="/admin/lecture/<%= lecture._id %>/edit" class="btn btn-outline-warning px-4">
      <i class="bi bi-pencil-square me-1"></i>Edit
    </a>
  <% } %>

  <button
    class="btn btn-primary px-4"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#lectureVideo<%= index %>"
    aria-expanded="false"
    aria-controls="lectureVideo<%= index %>"
  >
    Watch
  </button>

</div>
                </div>
              </div>
            </div>

            <div class="collapse" id="lectureVideo<%= index %>">
              <div class="video-frame shadow">
              <iframe
    src="<%= lecture.url %>"
    title="<%= lecture.title %>"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen>
</iframe>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="tab-pane fade" id="notes" role="tabpanel" aria-labelledby="notes-tab" tabindex="0">
        <div class="row g-4">
          <% noteList.forEach(note => { %>
            <div class="col-md-6">
              <div class="card content-list-card shadow-sm h-100">
                <div class="card-body p-4">
                  <div class="d-flex gap-3">
                    <div class="resource-icon bg-primary-subtle text-primary">
                      <i class="bi bi-file-earmark-text fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                      <div class="d-flex justify-content-between gap-3 mb-2">
                        <h2 class="h5 mb-0"><%= note.title %></h2>
                        <span class="badge text-bg-primary"><%= note.type %></span>
                      </div>
                      <p class="text-muted small mb-3">
                        <%= note.pages %> pages | Designed By <%= note.designedBy %>
                      </p>
                      <div class="d-flex gap-2 flex-wrap">
  <a href="<%= note.url %>" class="btn btn-outline-primary">
    <i class="bi bi-download me-1"></i>Open Notes
  </a>

  <% if(user && user.admin) { %>
    <a href="/admin/note/<%= note._id %>/edit" class="btn btn-outline-warning">
      <i class="bi bi-pencil-square me-1"></i>Edit
    </a>
  <% } %>
</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="tab-pane fade" id="practice" role="tabpanel" aria-labelledby="practice-tab" tabindex="0">
        <!-- Interactive Quizzes Section -->
        <h4 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-patch-question-fill text-primary"></i> Interactive Quizzes
        </h4>
        <% if (quizList.length === 0) { %>
          <p class="text-muted mb-4">No interactive quizzes available for this chapter.</p>
        <% } else { %>
          <div class="row g-4 mb-5">
            <% quizList.forEach(quiz => { %>
              <% 
                const attempts = quizAttempts.filter(att => att.quiz.toString() === quiz._id.toString());
                const bestAttempt = attempts.length > 0 ? attempts.reduce((prev, current) => (prev.score > current.score) ? prev : current) : null;
              %>
              <div class="col-md-6 col-xl-4">
                <div class="card content-list-card shadow-sm h-100 border-primary-subtle" style="border-left: 4px solid #0d6efd;">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="resource-icon bg-primary-subtle text-primary mb-2">
                        <i class="bi bi-lightning-fill fs-4"></i>
                      </div>
                      <% if (bestAttempt) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                          Score: <%= bestAttempt.score %>/<%= bestAttempt.totalQuestions %>
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                          Unattempted
                        </span>
                      <% } %>
                    </div>
                    
                    <h2 class="h5 fw-bold mb-2"><%= quiz.title %></h2>
                    <p class="text-muted small mb-4">
                      <i class="bi bi-question-circle me-1"></i><%= quiz.questions.length %> Questions
                    </p>

                    <div class="d-grid gap-2">
                      <% if (bestAttempt) { %>
                        <div class="d-flex gap-2">
                          <a href="/quiz/attempt/<%= bestAttempt._id %>" class="btn btn-outline-primary flex-grow-1">
                            <i class="bi bi-bar-chart-line me-1"></i>Results
                          </a>
                          <a href="/quiz/<%= quiz._id %>" class="btn btn-primary">
                            <i class="bi bi-arrow-repeat"></i> Retake
                          </a>
                        </div>
                      <% } else { %>
                        <a href="/quiz/<%= quiz._id %>" class="btn btn-primary">
                          Start Quiz <i class="bi bi-play-fill ms-1"></i>
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <hr class="my-5">

        <!-- Worksheets Section -->
        <h4 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-pdf-fill text-warning"></i> Practice Sheets (PDFs)
        </h4>
        <% if (sheetList.length === 0) { %>
          <p class="text-muted">No practice sheets uploaded yet.</p>
        <% } else { %>
          <div class="row g-4">
            <% sheetList.forEach(sheet => { %>
              <div class="col-md-6 col-xl-4">
                <div class="card content-list-card shadow-sm h-100">
                  <div class="card-body p-4">
                    <div class="resource-icon bg-warning-subtle text-warning mb-3">
                      <i class="bi bi-pencil-square fs-4"></i>
                    </div>
                    <h2 class="h5 fw-bold mb-2"><%= sheet.title %></h2>
                    <p class="text-muted mb-4">
                      <%= sheet.page %> | <%= sheet.level %>
                    </p>
                    <div class="d-grid gap-2">
                      <a href="<%= sheet.url %>" class="btn btn-primary">
                        Open Practice Sheet <i class="bi bi-arrow-right ms-1"></i>
                      </a>
                      <% if(user && user.admin) { %>
                        <a href="/admin/sheet/<%= sheet._id %>/edit" class="btn btn-outline-warning">
                          <i class="bi bi-pencil-square me-1"></i>Edit
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>
