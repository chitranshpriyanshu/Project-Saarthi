<% layout("/layouts/boilerplate.ejs") %>
<% //newChange %>
<main class="container py-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
    <div>
      <h1 class="fw-bold mb-1"><i class="bi bi-bell text-primary me-2"></i>Updates & Notifications</h1>
      <p class="text-muted mb-0">Stay up to date with exam notifications, results, and important dates.</p>
    </div>
    <% if (user && user.admin) { %>
      <% //newChange %>
      <a href="/admin/addUpdate" class="btn btn-danger rounded-pill px-4">
        <% //newChange %>
        <i class="bi bi-plus-circle me-2"></i> Add New Update
      </a>
    <% } %>
  </div>

  <form method="GET" class="d-flex gap-3 flex-wrap mb-5">
    <select name="exam" class="form-select" style="width:200px" onchange="this.form.submit()">
      <option value="">All Exams</option>
      <% //newChange %>
      <% exams.forEach(e => { %><option value="<%= e._id %>" <%= filters.exam===e._id.toString()?'selected':'' %>><%= e.examName %></option><% }) %>
    </select>
    <select name="category" class="form-select" style="width:220px" onchange="this.form.submit()">
      <option value="">All Categories</option>
      <% categories.forEach(c => { %><option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option><% }) %>
    </select>
    <a href="/updates" class="btn btn-outline-secondary">Clear</a>
  </form>

  <div class="timeline">
    <% updates.forEach(update => { %>
    <div class="timeline-item mb-4 ps-4 border-start border-2 <%= update.isImportant ? 'border-danger' : 'border-secondary' %>">
      <div class="card <%= update.isImportant ? 'border-danger' : '' %>">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="fw-semibold mb-0"><%= update.title %></h6>
            <% if (update.isImportant) { %><span class="badge bg-danger ms-2">Important</span><% } %>
          </div>
          <p class="text-muted small mb-2"><%= update.content %></p>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="badge bg-secondary-subtle text-secondary"><%= update.category %></span>
            <span class="text-muted small ms-auto"><%= new Date(update.date).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></span>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
    <% if (updates.length === 0) { %>
    <div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i>No updates found. Try changing filters.</div>
    <% } %>
  </div>
</main>